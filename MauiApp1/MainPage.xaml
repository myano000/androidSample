<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:MauiApp1.Behaviors"
             x:Class="MauiApp1.MainPage">

    <Grid BackgroundColor="LightGray">
        <Grid.Behaviors>
            <behaviors:ObservableTouchBehavior x:Name="TouchBehavior" />
        </Grid.Behaviors>

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Observable Touch Event Demo"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="{Binding DisplayText}"
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="{Binding LastGesture, StringFormat='Last Gesture: {0}'}"
                FontSize="16"
                HorizontalOptions="Center"
                TextColor="Blue" />

            <Label
                Text="{Binding Count, StringFormat='Tap Count: {0}'}"
                FontSize="16"
                HorizontalOptions="Center"
                TextColor="Green" />

            <Label
                Text="Touch anywhere on the screen to see events!"
                FontSize="14"
                HorizontalOptions="Center"
                TextColor="Gray"
                Margin="0,20,0,0" />

            <VerticalStackLayout Spacing="5" Margin="0,20,0,0">
                <Label Text="Supported Gestures:" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="• Tap" HorizontalOptions="Center" />
                <Label Text="• Double Tap" HorizontalOptions="Center" />
                <Label Text="• Long Press (500ms)" HorizontalOptions="Center" />
                <Label Text="• Swipe (Up, Down, Left, Right)" HorizontalOptions="Center" />
                <Label Text="• Touch Move" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
